# Copia este archivo como .env y ajusta los valores

# Puerto donde corre el servidor
PORT=3000

# Clave secreta para las sesiones (genera una larga y aleatoria)
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Minutos de inactividad antes de cerrar la sesión
SESSION_TIMEOUT_MIN=120

# Ponlo en production cuando uses HTTPS (obligatorio en producción)
NODE_ENV=development

# Panel privado del desarrollador (/panel-dev). Sin estas dos variables el
# panel responde 404. El hash se genera con bcryptjs (ver README).
DEV_USER=dev
DEV_PASSWORD_HASH=$2a$10$reemplaza-esto-por-un-hash-bcrypt

# Minutos de inactividad antes de cerrar la sesión del panel (5 a 720)
DEV_SESSION_TIMEOUT_MIN=60
